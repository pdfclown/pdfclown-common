<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.pdfclown</groupId>
    <artifactId>pdfclown-common-super</artifactId>
    <version>${revision}</version>
    <relativePath>../pdfclown-common-super/pom.xml</relativePath>
  </parent>

  <artifactId>pdfclown-common-base</artifactId>
  <packaging>pom</packaging>

  <name>${project.artifactId}</name>
  <description>Common build configuration for pdfClown.org projects</description>

  <profiles>
    <!--============================================================================================
      STATE PROFILES

      These (`@xxxxxxx`) profiles are meant to be triggered by activation conditions (project or
      environment state).
    =============================================================================================-->

    <profile>
      <id>@base</id>
      <!--
        BASE PROFILE

        Activates the base POM.

        NOTE: The public definitions of this POM are isolated into this profile in order to be
        available to inheriting projects without affecting its own build.
      -->
      <activation>
        <file>
          <missing>../pdfclown-common-base</missing>
        </file>
      </activation>
      <properties>
        <!--
          OVERRIDDEN PROPERTIES
        -->
        <!-- Common resources from classpath -->
        <buildResourcesDir
            combine.self="override"/>
        <internal.assemblies.basedir>${rootdir}/target/assemblies</internal.assemblies.basedir>
        <internal.assemblies.unpack.skip>false</internal.assemblies.unpack.skip>
        <!-- Root POM context, by default -->
        <rootdir>${project.basedir}</rootdir>

        <!--
          VERSIONS
        -->
        <pdfclown-common.version>${revision}</pdfclown-common.version>
      </properties>
      <build>
        <pluginManagement>
          <plugins>
            <!--
              WARNING: DO NOT move the `pdfclown-common-build` dependency declarations here below, up to
              the parent POM hierarchy, as they must be activated only outside the pdfclown-common
              project.
            -->

            <plugin>
              <groupId>com.diffplug.spotless</groupId>
              <artifactId>spotless-maven-plugin</artifactId>
              <dependencies>
                <!-- Common resources from classpath (configuration files) -->
                <dependency>
                  <groupId>org.pdfclown</groupId>
                  <artifactId>pdfclown-common-build</artifactId>
                  <version>${revision}</version>
                </dependency>
              </dependencies>
            </plugin>

            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-checkstyle-plugin</artifactId>
              <dependencies>
                <!-- Common resources from classpath (configuration files) -->
                <dependency>
                  <groupId>org.pdfclown</groupId>
                  <artifactId>pdfclown-common-build</artifactId>
                  <version>${revision}</version>
                </dependency>
              </dependencies>
            </plugin>

            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-javadoc-plugin</artifactId>
              <configuration>
                <docletArtifacts
                    combine.children="append">
                  <!-- Common resources from classpath (stylesheets, scripts, etc.) -->
                  <artifact>
                    <groupId>org.pdfclown</groupId>
                    <artifactId>pdfclown-common-build</artifactId>
                    <version>${revision}</version>
                  </artifact>
                </docletArtifacts>
              </configuration>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
  </profiles>
</project>
